# ========== 应用环境 ==========
ENV=dev

# ========== MySQL ==========
MYSQL_URL=mysql+aiomysql://root:gongan2024@localhost:3306/gongan_weishi

# ========== Redis ==========
REDIS_URL=redis://localhost:6379/0

# ========== Milvus ==========
MILVUS_URI=http://localhost:19530

# ========== Neo4j ==========
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=gongan2024

# ========== PostgreSQL (pgvector) ==========
POSTGRES_URL=postgresql+asyncpg://postgres:gongan2024@localhost:5432/gongan_memory

# ========== LLM ==========
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_FALLBACK_MODEL=qwen-plus

# ========== JWT ==========
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# ========== CORS ==========
CORS_ORIGINS=http://localhost:5173

# ========== Langfuse ==========
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ========== 生产部署 ==========
# Gunicorn（4核8G 服务器建议 1；4核16G 建议 2）
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120
GUNICORN_KEEPALIVE=5
GUNICORN_LOG_LEVEL=info

# 应用
APP_NAME=工安卫士
APP_VERSION=0.9.0
CORS_ORIGINS=http://localhost:5173,http://localhost:80

# BGE-M3 本地模型路径（生产环境可改为容器内路径）
BGE_M3_PATH=/app/models/bge-m3
