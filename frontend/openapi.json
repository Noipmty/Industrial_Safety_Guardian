{
  "openapi": "3.1.0",
  "info": {
    "title": "工安卫士 API",
    "version": "0.1.0",
    "description": "工业安全AI助手 OpenAPI 契约"
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "本地开发服务器"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": ["code", "message", "trace_id"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "trace_id": { "type": "string" }
        }
      },
      "User": {
        "type": "object",
        "required": ["id", "username", "real_name", "position", "role"],
        "properties": {
          "id": { "type": "integer" },
          "username": { "type": "string" },
          "real_name": { "type": "string" },
          "position": { "type": "string" },
          "role": { "type": "string" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string" },
          "password": { "type": "string" }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": ["access_token", "token_type", "user"],
        "properties": {
          "access_token": { "type": "string" },
          "token_type": { "type": "string", "enum": ["bearer"] },
          "user": { "$ref": "#/components/schemas/User" }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": ["username", "password", "real_name", "position"],
        "properties": {
          "username": { "type": "string" },
          "password": { "type": "string" },
          "real_name": { "type": "string" },
          "position": { "type": "string" },
          "role": { "type": "string" }
        }
      },
      "RegisterResponse": {
        "type": "object",
        "required": ["id", "username", "position", "role"],
        "properties": {
          "id": { "type": "integer" },
          "username": { "type": "string" },
          "position": { "type": "string" },
          "role": { "type": "string" }
        }
      },
      "RefreshResponse": {
        "type": "object",
        "required": ["access_token", "token_type"],
        "properties": {
          "access_token": { "type": "string" },
          "token_type": { "type": "string", "enum": ["bearer"] }
        }
      },
      "ChatRequest": {
        "type": "object",
        "required": ["message", "user_id"],
        "properties": {
          "session_id": { "type": "string" },
          "message": { "type": "string" },
          "user_id": { "type": "integer" },
          "stream": { "type": "boolean", "default": false }
        }
      },
      "ChatSource": {
        "type": "object",
        "required": ["doc_type", "score", "text"],
        "properties": {
          "doc_type": { "type": "string" },
          "score": { "type": "number", "format": "float" },
          "text": { "type": "string" }
        }
      },
      "ChatResponse": {
        "type": "object",
        "required": ["response", "intent", "sources", "session_id", "trace_id"],
        "properties": {
          "response": { "type": "string" },
          "intent": { "type": "string" },
          "sources": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ChatSource" }
          },
          "session_id": { "type": "string" },
          "trace_id": { "type": "string" }
        }
      },
      "ChatSession": {
        "type": "object",
        "required": ["session_id", "last_message", "created_at", "updated_at"],
        "properties": {
          "session_id": { "type": "string" },
          "last_message": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "ChatMessage": {
        "type": "object",
        "required": ["role", "content", "created_at"],
        "properties": {
          "role": { "type": "string", "enum": ["user", "assistant"] },
          "content": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "ExamGenerateRequest": {
        "type": "object",
        "required": ["user_id", "position", "question_types", "num_questions"],
        "properties": {
          "user_id": { "type": "integer" },
          "position": { "type": "string" },
          "question_types": {
            "type": "array",
            "items": { "type": "string" }
          },
          "num_questions": { "type": "integer" },
          "knowledge_tags": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "ExamGenerateResponse": {
        "type": "object",
        "required": ["exam_id", "status"],
        "properties": {
          "exam_id": { "type": "integer" },
          "status": { "type": "string", "enum": ["generating"] }
        }
      },
      "ExamQuestion": {
        "type": "object",
        "required": ["id", "question_type", "stem", "score"],
        "properties": {
          "id": { "type": "integer" },
          "question_type": { "type": "string" },
          "stem": { "type": "string" },
          "options": {
            "type": "array",
            "items": { "type": "string" }
          },
          "score": { "type": "number" }
        }
      },
      "ExamDetail": {
        "type": "object",
        "required": ["id", "position", "status", "questions", "total_score", "time_limit"],
        "properties": {
          "id": { "type": "integer" },
          "position": { "type": "string" },
          "status": { "type": "string" },
          "questions": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ExamQuestion" }
          },
          "total_score": { "type": "number" },
          "time_limit": { "type": "integer" }
        }
      },
      "ExamSubmitRequest": {
        "type": "object",
        "required": ["answers"],
        "properties": {
          "answers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["question_id", "user_answer"],
              "properties": {
                "question_id": { "type": "integer" },
                "user_answer": { "type": "string" }
              }
            }
          }
        }
      },
      "GradedAnswer": {
        "type": "object",
        "required": ["question_id", "user_answer", "score", "graded_by"],
        "properties": {
          "question_id": { "type": "integer" },
          "user_answer": { "type": "string" },
          "score": { "type": "number" },
          "grading_detail": { "type": "string" },
          "graded_by": { "type": "string" }
        }
      },
      "ExamSubmitResponse": {
        "type": "object",
        "required": ["exam_id", "status", "total_score", "answers"],
        "properties": {
          "exam_id": { "type": "integer" },
          "status": { "type": "string", "enum": ["graded"] },
          "total_score": { "type": "number" },
          "answers": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/GradedAnswer" }
          }
        }
      },
      "ExamResultAnalysis": {
        "type": "object",
        "required": ["weak_points", "strong_points"],
        "properties": {
          "weak_points": {
            "type": "array",
            "items": { "type": "string" }
          },
          "strong_points": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "ExamResult": {
        "type": "object",
        "required": ["exam", "questions", "answers", "analysis"],
        "properties": {
          "exam": { "$ref": "#/components/schemas/ExamDetail" },
          "questions": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ExamQuestion" }
          },
          "answers": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/GradedAnswer" }
          },
          "analysis": { "$ref": "#/components/schemas/ExamResultAnalysis" }
        }
      },
      "ExamListItem": {
        "type": "object",
        "required": ["id", "position", "status", "total_score", "created_at"],
        "properties": {
          "id": { "type": "integer" },
          "position": { "type": "string" },
          "status": { "type": "string" },
          "total_score": { "type": "number" },
          "created_at": { "type": "string", "format": "date-time" },
          "submitted_at": { "type": "string", "format": "date-time" }
        }
      },
      "DocumentUploadResponse": {
        "type": "object",
        "required": ["doc_id", "status"],
        "properties": {
          "doc_id": { "type": "integer" },
          "status": { "type": "string", "enum": ["processing"] }
        }
      },
      "DocumentListItem": {
        "type": "object",
        "required": ["id", "title", "doc_type", "version", "status", "created_at"],
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "doc_type": { "type": "string" },
          "version": { "type": "string" },
          "status": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "DocumentStatus": {
        "type": "object",
        "required": ["id", "status", "progress", "chunks_count"],
        "properties": {
          "id": { "type": "integer" },
          "status": { "type": "string" },
          "progress": { "type": "number", "format": "float" },
          "chunks_count": { "type": "integer" },
          "error": { "type": "string" }
        }
      },
      "AdminUser": {
        "type": "object",
        "required": ["id", "username", "real_name", "position", "role", "created_at"],
        "properties": {
          "id": { "type": "integer" },
          "username": { "type": "string" },
          "real_name": { "type": "string" },
          "position": { "type": "string" },
          "role": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "AdminStats": {
        "type": "object",
        "required": ["total_users", "total_docs", "total_exams", "total_questions", "avg_score"],
        "properties": {
          "total_users": { "type": "integer" },
          "total_docs": { "type": "integer" },
          "total_exams": { "type": "integer" },
          "total_questions": { "type": "integer" },
          "avg_score": { "type": "number" }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": ["status", "version", "checks"],
        "properties": {
          "status": { "type": "string", "enum": ["ok"] },
          "version": { "type": "string" },
          "checks": {
            "type": "object",
            "required": ["mysql", "redis"],
            "properties": {
              "mysql": { "type": "string", "enum": ["up"] },
              "redis": { "type": "string", "enum": ["up"] }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "健康检查",
        "operationId": "health",
        "tags": ["通用"],
        "responses": {
          "200": {
            "description": "服务健康",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "用户登录",
        "operationId": "login",
        "tags": ["认证"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginResponse" }
              }
            }
          },
          "401": {
            "description": "认证失败",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "summary": "用户注册",
        "operationId": "register",
        "tags": ["认证"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "注册成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RegisterResponse" }
              }
            }
          },
          "409": {
            "description": "用户已存在",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "summary": "获取当前用户",
        "operationId": "getCurrentUser",
        "tags": ["认证"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "当前用户信息",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "401": {
            "description": "未认证",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "summary": "刷新令牌",
        "operationId": "refreshToken",
        "tags": ["认证"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "刷新成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RefreshResponse" }
              }
            }
          },
          "401": {
            "description": "刷新失败",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/chat": {
      "post": {
        "summary": "发送对话消息",
        "operationId": "sendChat",
        "tags": ["对话"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChatRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "对话响应",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ChatResponse" }
              },
              "text/event-stream": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": { "type": "string", "enum": ["token", "sources", "done"] },
                    "content": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "请求无效",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/chat/sessions": {
      "get": {
        "summary": "获取会话列表",
        "operationId": "getChatSessions",
        "tags": ["对话"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "user_id",
            "in": "query",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "会话列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/ChatSession" }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/chat/sessions/{session_id}/messages": {
      "get": {
        "summary": "获取会话消息",
        "operationId": "getChatMessages",
        "tags": ["对话"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "消息列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/ChatMessage" }
                }
              }
            }
          },
          "404": {
            "description": "会话不存在",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/chat/sessions/{session_id}": {
      "delete": {
        "summary": "删除会话",
        "operationId": "deleteChatSession",
        "tags": ["对话"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "204": {
            "description": "删除成功"
          },
          "404": {
            "description": "会话不存在",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/exam/generate": {
      "post": {
        "summary": "生成试卷",
        "operationId": "generateExam",
        "tags": ["考试"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ExamGenerateRequest" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "生成任务已接受",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ExamGenerateResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/exam/{exam_id}": {
      "get": {
        "summary": "获取试卷详情",
        "operationId": "getExam",
        "tags": ["考试"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "exam_id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "试卷详情",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ExamDetail" }
              }
            }
          },
          "404": {
            "description": "试卷不存在",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/exam/{exam_id}/submit": {
      "post": {
        "summary": "提交试卷",
        "operationId": "submitExam",
        "tags": ["考试"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "exam_id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ExamSubmitRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "批改结果",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ExamSubmitResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/exam/{exam_id}/result": {
      "get": {
        "summary": "获取考试结果",
        "operationId": "getExamResult",
        "tags": ["考试"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "exam_id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "考试结果分析",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ExamResult" }
              }
            }
          },
          "404": {
            "description": "结果不存在",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/exam/list": {
      "get": {
        "summary": "获取考试列表",
        "operationId": "getExamList",
        "tags": ["考试"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "user_id",
            "in": "query",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "考试列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/ExamListItem" }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/documents": {
      "post": {
        "summary": "上传文档",
        "operationId": "uploadDocument",
        "tags": ["管理"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file", "doc_type", "title"],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "doc_type": { "type": "string" },
                  "title": { "type": "string" },
                  "version": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "上传任务已接受",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DocumentUploadResponse" }
              }
            }
          }
        }
      },
      "get": {
        "summary": "获取文档列表",
        "operationId": "getDocuments",
        "tags": ["管理"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "文档列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/DocumentListItem" }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/documents/{id}/status": {
      "get": {
        "summary": "获取文档处理状态",
        "operationId": "getDocumentStatus",
        "tags": ["管理"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
